{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Start infra",
      "type": "shell",
      "command": "docker compose up -d",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop infra",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Redis: Seed config",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/redis-seed-config.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Backend: Build all",
      "type": "shell",
      "command": "dotnet build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Backend: Run all services",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/run-all.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: npm install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Dashboard (Next.js)",
      "type": "shell",
      "command": "npm run dev:dashboard",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready|started server|Local:)"
        }
      }
    },
    {
      "label": "Frontend: Widget (Vite)",
      "type": "shell",
      "command": "npm run dev:widget",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|ready in)"
        }
      }
    }
  ]
}
