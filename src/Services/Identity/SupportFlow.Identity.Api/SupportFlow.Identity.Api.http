@SupportFlow.Identity.Api_HostAddress = http://localhost:5010
@Gateway_HostAddress = http://localhost:5000

### Health
GET {{SupportFlow.Identity.Api_HostAddress}}/health/live

### Register (via gateway)
POST {{Gateway_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "owner@acme.com",
  "password": "SecurePass123!",
  "fullName": "John Smith",
  "workspaceName": "Acme Corp"
}

### Login (via gateway)
POST {{Gateway_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "owner@company.com",
  "password": "SecurePass123!"
}

### Refresh (via gateway)
POST {{Gateway_HostAddress}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Me (via gateway)
GET {{Gateway_HostAddress}}/api/v1/auth/me
Authorization: Bearer {{accessToken}}

### Logout (via gateway)
POST {{Gateway_HostAddress}}/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
