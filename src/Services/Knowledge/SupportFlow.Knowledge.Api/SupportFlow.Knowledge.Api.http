@SupportFlow.Knowledge.Api_HostAddress = http://localhost:5060
@AccessToken = paste-jwt-access-token

GET {{SupportFlow.Knowledge.Api_HostAddress}}/health/live
Accept: application/json

###

GET {{SupportFlow.Knowledge.Api_HostAddress}}/swagger/v1/swagger.json
Accept: application/json

###

GET {{SupportFlow.Knowledge.Api_HostAddress}}/api/v1/knowledge/articles?page=1&pageSize=30
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{SupportFlow.Knowledge.Api_HostAddress}}/api/v1/knowledge/articles
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "title": "Reset your password",
  "content": "<p>Use the Forgot password link and verify the one-time code.</p>",
  "category": "Account",
  "publish": true
}

###
