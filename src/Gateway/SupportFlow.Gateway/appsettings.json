{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "Services": {
    "Identity": "http://localhost:5010",
    "Workspace": "http://localhost:5020",
    "Conversation": "http://localhost:5030",
    "Ticket": "http://localhost:5040",
    "Customer": "http://localhost:5050",
    "Knowledge": "http://localhost:5060",
    "AI": "http://localhost:5070",
    "Notification": "http://localhost:5080"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "workspace-members-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/workspaces/current/members/{**catch-all}" }
      },
      "workspace-members-exact-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/workspaces/current/members" }
      },
      "workspace-route": {
        "ClusterId": "workspace-cluster",
        "Match": { "Path": "/api/v1/workspaces/{**catch-all}" }
      },
      "conversation-route": {
        "ClusterId": "conversation-cluster",
        "Match": { "Path": "/api/v1/conversations/{**catch-all}" }
      },
      "ticket-route": {
        "ClusterId": "ticket-cluster",
        "Match": { "Path": "/api/v1/tickets/{**catch-all}" }
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": { "Path": "/api/v1/customers/{**catch-all}" }
      },
      "knowledge-route": {
        "ClusterId": "knowledge-cluster",
        "Match": { "Path": "/api/v1/knowledge/{**catch-all}" }
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": { "Path": "/api/v1/ai/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" }
      },
      "widget-route": {
        "ClusterId": "conversation-cluster",
        "Match": { "Path": "/api/v1/widget/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": { "Address": "http://localhost:5010/" }
        }
      },
      "workspace-cluster": {
        "Destinations": {
          "workspace": { "Address": "http://localhost:5020/" }
        }
      },
      "conversation-cluster": {
        "Destinations": {
          "conversation": { "Address": "http://localhost:5030/" }
        }
      },
      "ticket-cluster": {
        "Destinations": {
          "ticket": { "Address": "http://localhost:5040/" }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "customer": { "Address": "http://localhost:5050/" }
        }
      },
      "knowledge-cluster": {
        "Destinations": {
          "knowledge": { "Address": "http://localhost:5060/" }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai": { "Address": "http://localhost:5070/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": { "Address": "http://localhost:5080/" }
        }
      }
    }
  }
}
